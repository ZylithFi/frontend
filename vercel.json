{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "https://app.zylith.fi",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://app.zylith.fi/$1",
      "permanent": true
    }
  ]
}
